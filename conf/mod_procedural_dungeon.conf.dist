[worldserver]

########################################
# mod-procedural-dungeon configuration
########################################
#
#    ProceduralDungeon.Enable
#        Description: Enable the procedural dungeon module.
#        Default:     0 - Disabled
#                     1 - Enabled
#        Requires the module SQL to be applied and CheckGameObjectLoS = 1
#        (default) so walls block creature line of sight.

ProceduralDungeon.Enable = 0

#
#    ProceduralDungeon.BaseMapId
#        Description: Client-known map the dungeon is assembled on. The map
#                     must have an instance_template row and be a dungeon
#                     server-side (see mod_pdungeon_base.sql; default setup
#                     covers map 37 'Azshara Crater').
#        Default:     37

ProceduralDungeon.BaseMapId = 37

#
#    ProceduralDungeon.Center.X / .Y / .Z / .O
#        Description: World coordinates of the grid center on the base map.
#                     Scout a large, flat, open area with a GM character
#                     (.gps) and put the coordinates here. Z is used as the
#                     fallback ground height where terrain sampling fails.
#        Default:     0 / 0 / 0 / 0

ProceduralDungeon.Center.X = 0
ProceduralDungeon.Center.Y = 0
ProceduralDungeon.Center.Z = 0
ProceduralDungeon.Center.O = 0

#
#    ProceduralDungeon.TileSize
#        Description: Edge length of one layout tile in yards. Corridors are
#                     2 tiles wide. 9.5 makes the 28.5yd Wintergrasp wall fill
#                     its 3-tile slot EXACTLY (3 * 9.5 = 28.5). WMO GameObjects
#                     ignore the `size` scale field, so tile size is the only
#                     lever that makes walls tile gap-free. (10 = 30yd slot left
#                     a 1.5yd gap per joint.)
#        Default:     9.5

ProceduralDungeon.TileSize = 9.5

#
#    ProceduralDungeon.WallOverlap
#        Description: Yards each straight wall piece is pulled back along the run
#                     axis. DEFAULT 0 (off): the pull is cumulative, so on long
#                     runs it dragged the far end inward and OPENED gaps at
#                     corners. Wall overlap is now handled by per-piece model
#                     scale (gameobject_template.size), which extends pieces
#                     symmetrically into both neighbours AND corners without
#                     drift. Leave at 0 unless you know you want the old
#                     run-axis pull.
#        Default:     0

ProceduralDungeon.WallOverlap = 0

#
#    ProceduralDungeon.WallJunctionExtend
#        Description: Extra yards a wall run's END piece is pushed further INTO
#                     the perpendicular wall it abuts, ON TOP of the built-in
#                     one-tile share (which already buries the terminal piece a
#                     full tile ~9.5yd into the junction - well past the 2-3yd
#                     taper gap). DEFAULT 0: WMO pieces are rigid, so this push
#                     is a translation that ALSO retreats the piece's inner face
#                     by the same amount, opening a mid-wall gap at the interior
#                     joint of a multi-piece run. Leave at 0 (the one-tile share
#                     is geometrically clean); only raise if a junction still
#                     gaps, then re-check long walls for new mid-run gaps.
#        Default:     0

ProceduralDungeon.WallJunctionExtend = 0

#
#    ProceduralDungeon.GateWidthExtra
#        Description: Extra scale added to a gate on top of its opening span, so
#                     the (M2, scalable) gate overlaps the flanking tapered walls
#                     and a player can't slip past its edge to skip the gate.
#                     Units are scale (1 = one tile ~9.5yd); 0.2 buries ~1yd into
#                     each flank. Raise slightly if a gate is still skippable.
#        Default:     0.2

ProceduralDungeon.GateWidthExtra = 0.2

#
#    ProceduralDungeon.JunctionTowers
#        Description: Drop a tower piece on every wall corner/junction/step (a
#                     Wall tile with both a horizontal and a vertical wall
#                     neighbour). Its chunky footprint covers the seam that
#                     straight wall runs leave at these spots (tapered bases +
#                     offset "steps"), reading as a fortress corner tower.
#        Default:     1 - Enabled
#                     0 - Disabled (accept the residual junction seams)

ProceduralDungeon.JunctionTowers = 1

#
#    ProceduralDungeon.Grid.Width / .Height
#        Description: Layout grid size in tiles. 64x64 tiles at TileSize 10
#                     covers 640x640 yards on the base map.
#        Default:     64 / 64

ProceduralDungeon.Grid.Width = 64
ProceduralDungeon.Grid.Height = 64

#
#    ProceduralDungeon.Rooms.Min / .Max
#        Description: Rooms per run (before semantics: entrance, combat,
#                     elite, treasure, shrine, boss).
#        Default:     10 / 16

ProceduralDungeon.Rooms.Min = 10
ProceduralDungeon.Rooms.Max = 16

#
#    ProceduralDungeon.Rooms.SizeMin / .SizeMax
#        Description: Room edge lengths in tiles (forced odd).
#        Default:     5 / 11

ProceduralDungeon.Rooms.SizeMin = 5
ProceduralDungeon.Rooms.SizeMax = 11

#
#    ProceduralDungeon.LoopChance
#        Description: Percent chance to keep a non-MST connection as an
#                     extra loop corridor (alternate routes).
#        Default:     15

ProceduralDungeon.LoopChance = 15

#
#    ProceduralDungeon.TorchEvery
#        Description: Place a torch on every Nth eligible wall tile.
#        Default:     4

ProceduralDungeon.TorchEvery = 4

#
#    ProceduralDungeon.Theme
#        Description: Palette theme (pdungeon_palette.theme) used for pieces.
#        Default:     "wg"

ProceduralDungeon.Theme = "wg"

#
#    ProceduralDungeon.Spawn.BatchSize
#        Description: Objects spawned per map update tick while the dungeon
#                     materializes (higher = faster build-out, bigger hitch).
#        Default:     50

ProceduralDungeon.Spawn.BatchSize = 50

#
#    ProceduralDungeon.Spawn.MaxGameObjects
#        Description: Hard cap on planned spawns per run (safety valve).
#        Default:     1500

ProceduralDungeon.Spawn.MaxGameObjects = 1500

#
#    ProceduralDungeon.Mob.PackSize.Min / .Max
#        Description: Trash mobs per combat room.
#        Default:     3 / 5

ProceduralDungeon.Mob.PackSize.Min = 3
ProceduralDungeon.Mob.PackSize.Max = 5

#
#    ProceduralDungeon.Mob.CasterChance
#        Description: Percent chance that a trash mob is a caster.
#        Default:     30

ProceduralDungeon.Mob.CasterChance = 30

#
#    ProceduralDungeon.Mob.Level
#        Description: Override level applied to spawned mobs (0 = use the
#                     creature_template levels).
#        Default:     0

ProceduralDungeon.Mob.Level = 0

#
#    ProceduralDungeon.Mob.LeashTiles
#        Description: Leash radius around a mob's spawn point, in tiles.
#        Default:     18

ProceduralDungeon.Mob.LeashTiles = 18

#
#    ProceduralDungeon.ShrineSpellId
#        Description: Spell the shrine casts on its user (one-shot per run).
#        Default:     48161 (Power Word: Fortitude)

ProceduralDungeon.ShrineSpellId = 48161

#
#    ProceduralDungeon.Announce
#        Description: Announce the module to players on login.
#        Default:     1

ProceduralDungeon.Announce = 1

#
#    ProceduralDungeon.Debug
#        Description: Log the generated ASCII layout and timings.
#        Default:     0

ProceduralDungeon.Debug = 0

###############################################################################
# PROCEDURAL DUNGEON v2 (block kit, client-composed terrain)
#
# v2 does not spawn a dungeon out of GameObjects. It decides which kit block
# sits at which block coordinate, says so in an FLPD2 manifest, and the client
# composes the terrain from that. The server keeps NO terrain files for the
# dungeon map, which is what makes a layout per player possible at all.
#
# This is the FIRST slice of the engine glue. There is no AIO push and no entry
# gate yet, so the `.pdungeon v2` commands are GM-only: a player without the
# client DLL would enter the map and find nothing but void.
#
# v1's keys above are untouched and v1 keeps working until it is replaced.
###############################################################################

#
#    ProceduralDungeon.V2.Enable
#        Description: Enable the v2 command family. Off by default.
#        Default:     0
#

ProceduralDungeon.V2.Enable = 0

#
#    ProceduralDungeon.V2.MapId
#        Description: The dungeon's own map. Needs its Map/MapDifficulty/
#                     AreaTable rows client-side and the map_dbc /
#                     mapdifficulty_dbc / areatable_dbc / instance_template
#                     rows server-side - both are produced by
#                     ForgottenLand2.0/scripts/47_pd_map760_rows.py.
#        Default:     760
#

ProceduralDungeon.V2.MapId = 760

#
#    ProceduralDungeon.V2.FloorZ
#        Description: The kit's floor plane. MUST match the height the block kit
#                     was generated at, or the server places players above or
#                     below the terrain the client draws.
#        Default:     50.0
#

ProceduralDungeon.V2.FloorZ = 50.0

#
#    ProceduralDungeon.V2.Rooms / .BossRooms
#        Description: ORDINARY rooms in a generated layout, and boss rooms.
#                     The entrance and the boss halls come ON TOP of .Rooms:
#                     5 / 1 builds five ordinary rooms, one boss hall and one
#                     entrance, and the HUD's room pair counts the five.
#                     These are now the FALLBACK only: an account that has a
#                     pdungeon_account row gets 01 §8's rooms (its own cfg_rooms
#                     clamped into 3 + dlvl, hard cap 15) and boss rooms
#                     (1 + dlvl/10) instead. They still decide what a fresh
#                     install generates before anyone has played.
#        Default:     5 / 1
#

ProceduralDungeon.V2.Rooms = 5
ProceduralDungeon.V2.BossRooms = 1

#
#    ProceduralDungeon.V2.FieldBlocks
#        Description: Planning field, in blocks, square. 8 is exactly one ADT
#                     tile, so a layout of that size composes into a single tile.
#        Default:     8
#

ProceduralDungeon.V2.FieldBlocks = 8

#
#    ProceduralDungeon.V2.OriginBX / .OriginBY
#        Description: Global block coordinate of the field's origin. A tile is 8
#                     blocks, so 256 puts the field on tile 32. Changing these
#                     moves the dungeon to another tile of the same map.
#        Default:     256 / 256
#

ProceduralDungeon.V2.OriginBX = 256
ProceduralDungeon.V2.OriginBY = 256

#
#    ProceduralDungeon.V2.DetourChance
#        Description: Round B: percent chance, per boss segment, that a loop
#                     room hangs off the main path - out of a straight corridor
#                     run to the side, around a corner into an extra room, out
#                     of its far side and back into the run two cells further.
#                     One per segment at most; the room is additional to the
#                     room count. Replaces V2.LoopChance, now withdrawn.
#                     Stored per account as gen_loop_pct with the layout.
#        Default:     33
#

ProceduralDungeon.V2.DetourChance = 33

#
#    ProceduralDungeon.V2.Branches
#        Description: Round B: pocket rooms hanging off the main path, at most
#                     one per ordinary spine room and never more than a third
#                     of the rooms. Pockets come out of the same room budget,
#                     so the total room count does not change. Stored per
#                     account as gen_branches with the layout.
#        Default:     2
#

ProceduralDungeon.V2.Branches = 2

#
#    ProceduralDungeon.V2.Theme
#        Description: The kit theme NEW generations use. 1 = mine (walled
#                     caverns, timber frames, log tunnels), 2 = city (cobble
#                     plazas, street lamps, fountain and silo ring rooms).
#                     A stored dungeon keeps the theme it was generated with
#                     whatever this says (masks for ALL themes stay loaded),
#                     and `.pdungeon v2 gen [seed] [theme]` overrides it for
#                     one GM test generation.
#        Default:     2 - the city is the standard look the UI presents;
#                     the mine stays reachable with `gen [seed] 1`.
#

ProceduralDungeon.V2.Theme = 2

#
#    ProceduralDungeon.V2.RequiredDllVersion
#        Description: Minimum FLStream.dll bridge version the entry gate
#                     accepts. A client below it (or with no DLL at all) is
#                     denied politely instead of entering a map whose terrain
#                     its client cannot compose - which CRASHES that client.
#        Default:     1
#

ProceduralDungeon.V2.RequiredDllVersion = 1

#
#    ProceduralDungeon.V2.AckTimeoutMs
#        Description: How long a pushed manifest may go unanswered before the
#                     gate re-pushes it (once per push) on the next entry
#                     attempt.
#        Default:     5000
#

ProceduralDungeon.V2.AckTimeoutMs = 5000

#
#    ProceduralDungeon.V2.ManifestPath
#        Description: Where `.pdungeon v2 gen` writes the manifest. This is a
#                     TEMPORARY transport: until PDClientLink pushes manifests
#                     over AIO, the operator hands the file to the client with
#                     the DLL's dev-only LOAD verb. Empty disables writing.
#        Default:     "" (disabled)
#        Example:     "C:/wowstuff/ForgottenLand2.0/output/pd_live_manifest.txt"
#

ProceduralDungeon.V2.ManifestPath = ""

#
#    ProceduralDungeon.V2.XP.PerRoom
#        Description: Dungeon XP awarded per room cleared. 01 §8: dungeon XP is
#                     rooms x this and NOTHING else - deliberately independent
#                     of difficulty, because the moment difficulty pays XP the
#                     only rational setting is the highest one.
#        Default:     10
#

ProceduralDungeon.V2.XP.PerRoom = 10

#
#    ProceduralDungeon.V2.XP.PerDlvl
#        Description: Cost of the FIRST dungeon level. Every next level costs
#                     10 % more than the one before it, floored to a whole
#                     number at each step (100, 110, 121, 133, 146, 160, 176,
#                     193, 212, 233, ... - reaching dlvl 10 costs 1584 in
#                     total). The curve lives here rather than in the code
#                     because 01 §8 leaves it open until play says what it
#                     should be; the 10 % growth itself is in PDv2GameMath.h,
#                     where the harness can pin it.
#        Default:     100
#

ProceduralDungeon.V2.XP.PerDlvl = 100

#
#    ProceduralDungeon.V2.DlvlCap
#        Description: Highest reachable dungeon level. Past dlvl 12 the room
#                     count is already at its cap, so what dlvl still buys is
#                     boss rooms (1 + dlvl/10) and pack unlocks. It does NOT
#                     gate difficulty any more - that dial is open from the
#                     first run (2026-08-08).
#        Default:     30
#

ProceduralDungeon.V2.DlvlCap = 30

#
#    ProceduralDungeon.V2.Diff.HealthPctPerLevel
#        Description: Percent added to a dungeon mob's HP per point of the
#                     difficulty dial (1..100). mult = 1 + difficulty * pct/100,
#                     so 5 means difficulty 1 is x1.05 and difficulty 100 is x6.
#                     The default is mod-dungeon-challenge's LIVE value on this
#                     server (DungeonChallenge.HealthMultiplierPerLevel = 5 in
#                     dcore/configs/modules/mod_dungeon_challenge.conf; note the
#                     .dist there still says 15). PDv2 owns its own key so the
#                     two dungeons can be tuned apart.
#        Default:     5
#

ProceduralDungeon.V2.Diff.HealthPctPerLevel = 5

#
#    ProceduralDungeon.V2.Diff.DamagePctPerLevel
#        Description: The same curve for outgoing damage - melee, spell and
#                     periodic alike. Default = mod-dungeon-challenge's LIVE
#                     DungeonChallenge.DamageMultiplierPerLevel = 2. Damage
#                     climbs slower than HP on purpose: a fight that takes
#                     longer is tense, a fight that one-shots is not.
#        Default:     2
#

ProceduralDungeon.V2.Diff.DamagePctPerLevel = 2

#
#    ProceduralDungeon.V2.Affix.Percentage
#        Description: Percent chance PER ROOM that exactly ONE of its trash
#                     mobs is that room's affix carrier - at most one per room
#                     (operator rule 2026-08-09; the earlier per-mob roll
#                     clustered). The carrier wears every affix its difficulty
#                     unlocks; bosses never do, mirroring mod-dungeon-challenge.
#                     The affix SPELLS are that module's (900050-900060, its
#                     own DBC work); PDv2 only references them, and which ones
#                     apply at which difficulty lives in the `pdungeon_affixes`
#                     table - so retuning is SQL, not a rebuild. Default = that
#                     module's LIVE DungeonChallenge.AffixPercentage. 0 turns
#                     affixes off.
#
#                     NOTE: this number is part of the spawn draw's seeded
#                     stream, so changing it re-rolls WHICH creatures a stored
#                     layout spawns (the layout itself is unaffected).
#        Default:     40
#

ProceduralDungeon.V2.Affix.Percentage = 40

#
#    ProceduralDungeon.V2.SpawnsPerRoom
#        Description: Trash placed in each NORMAL (non-entrance, non-boss) room.
#                     Boss rooms have their own count - see BossRoomAdds below;
#                     this key stopped covering them on 2026-08-08, when normal
#                     rooms were asked to grow and boss rooms were not. The room
#                     is 66.67 yd square, so this is a density knob, not a
#                     difficulty one - difficulty scales HP and damage (01 §8),
#                     never the head count.
#        Default:     5
#

ProceduralDungeon.V2.SpawnsPerRoom = 5

#
#    ProceduralDungeon.V2.BossRoomAdds
#        Description: Trash placed BESIDE the boss in a boss room. The boss
#                     itself is always exactly one creature on top of this, so
#                     the default gives a boss room of three. The room's first
#                     spawn is the boss and run completion keys on that slot,
#                     so 0 here is legal (a lone boss) - it does not strand the
#                     run.
#        Default:     2
#

ProceduralDungeon.V2.BossRoomAdds = 2

#
#    ProceduralDungeon.V2.Loot.BonusRollPct
#        Description: Chance per kill of a module-side bonus roll on the FL mat
#                     table (items 920100+), on TOP of the creature's native
#                     loot, which stays untouched - that is what makes the
#                     dungeon a target-farming mechanism (01 §8). The roll is
#                     scaled by lootMult, which runs from x1.00 at difficulty 1
#                     to x3.00 at difficulty 100, times the caster factor
#                     (0.8 + 0.5 x r).
#        Default:     15
#

ProceduralDungeon.V2.Loot.BonusRollPct = 15

#
#    ProceduralDungeon.V2.Loot.Currency.Tier1.Item
#    ProceduralDungeon.V2.Loot.Currency.Tier2.Item
#    ProceduralDungeon.V2.Loot.Currency.Tier3.Item
#    ProceduralDungeon.V2.Loot.Currency.Tier4.Item
#    ProceduralDungeon.V2.Loot.Currency.Tier5.Item
#        Description: Round E (2026-09-10): the five dungeon currencies, from
#                     the white Faded Remnant to the orange Eternal Remnant.
#                     They are what a run pays out in, and what Forgotten
#                     Talents are bought with.
#
#                     These five keys are the ONLY place the module names an
#                     item id - no PD item id is written anywhere in the code -
#                     so regenerating mod_pdungeon_currency.sql at different
#                     entries needs a conf edit and no rebuild. Point
#                     mod-forgotten-talents' own ForgottenTalents.Currency.*
#                     keys at the same five ids, or it will take payment in
#                     something nobody drops.
#
#                     0 is refused (it is not an item and every grant would
#                     fail silently). Retire a tier with its ChancePct below.
#
#                     WP12 (2026-09-11): THESE FIVE ARE CURRENCY TOKENS. They
#                     live in the character sheet's Currency tab, not in the
#                     bags: mod_pdungeon_currency.sql gives them class 10 and
#                     BagFamily 8192, so the core stores every grant in the 32
#                     hidden currency slots. Three consequences an operator
#                     should know -
#                       * they cost no bag space, and T1 drops from every mob;
#                       * neither mod-loot-filter nor the Endless Storage can
#                         take them any more. Both deposit predicates only
#                         accept classes 9 / 0+5 / 7 / 3, which is why the
#                         Remnants USED to slip into the storage and become
#                         unspendable; V2.Loot.MatsToStorage's by-entry guard
#                         below is now belt AND braces;
#                       * the Forgotten Talents tree is unaffected - it pays
#                         with HasItemCount / DestroyItemCount and the core
#                         counts the currency slots alongside the bags.
#                     Remnants a character earned BEFORE this change stay in
#                     the bags until that character's next login, where the
#                     module moves them across once and says so in the log.
#                     Point a tier at an item whose template is NOT a currency
#                     token and that tier simply behaves the old way.
#        Default:     920105 / 920106 / 920107 / 920108 / 920109 - the rows
#                     mod_pdungeon_currency.sql creates
#

ProceduralDungeon.V2.Loot.Currency.Tier1.Item = 920105
ProceduralDungeon.V2.Loot.Currency.Tier2.Item = 920106
ProceduralDungeon.V2.Loot.Currency.Tier3.Item = 920107
ProceduralDungeon.V2.Loot.Currency.Tier4.Item = 920108
ProceduralDungeon.V2.Loot.Currency.Tier5.Item = 920109

#
#    ProceduralDungeon.V2.Loot.Currency.Tier1.ChancePct
#    ProceduralDungeon.V2.Loot.Currency.Tier2.ChancePct
#    ProceduralDungeon.V2.Loot.Currency.Tier3.ChancePct
#    ProceduralDungeon.V2.Loot.Currency.Tier4.ChancePct
#    ProceduralDungeon.V2.Loot.Currency.Tier5.ChancePct
#        Description: Round E (2026-09-10): the chance of one unit of that
#                     tier, in percent, BEFORE the room factor scales it (see
#                     RoomsBaseline below).
#
#                     Tiers 1 to 3 are rolled on every dungeon mob, for every
#                     player on the map - so nobody loses a drop to somebody
#                     else's tag, and the steep 100 / 5 / 1 curve is what makes
#                     the blue one worth the walk. Tiers 4 and 5 come out of
#                     Chromie's Cache alone, rolled once per looter when the
#                     cache is opened, and are gated by the two MinDiff keys.
#
#                     0 retires that one tier without touching the other four;
#                     100 is every mob (tiers 1 to 3) or every looter (4, 5).
#                     Nothing here says how MUCH drops - a hit is one unit, and
#                     the way to pay more per kill is the room factor or a
#                     longer dungeon.
#        Default:     100 / 5 / 1 / 50 / 10
#

ProceduralDungeon.V2.Loot.Currency.Tier1.ChancePct = 100
ProceduralDungeon.V2.Loot.Currency.Tier2.ChancePct = 5
ProceduralDungeon.V2.Loot.Currency.Tier3.ChancePct = 1
ProceduralDungeon.V2.Loot.Currency.Tier4.ChancePct = 50
ProceduralDungeon.V2.Loot.Currency.Tier5.ChancePct = 10

#
#    ProceduralDungeon.V2.Loot.Currency.Tier4.MinDiff
#    ProceduralDungeon.V2.Loot.Currency.Tier5.MinDiff
#        Description: Round E (2026-09-10): the run difficulty the two cache
#                     tiers need before they can drop at all, on the same
#                     1..100 dial `.pdungeon v2 set difficulty` moves. The
#                     run's difficulty is frozen when it is generated, so
#                     raising the dial mid-run does not unlock anything.
#
#                     Tiers 1 to 3 have no such key on purpose: they sit at the
#                     bottom of the dial and every run clears them. These two
#                     gates are the whole reason to set a hard run up - without
#                     them the purple and the orange would rain on difficulty 1
#                     and the dial would only cost the player health bars.
#
#                     Clamped into 1..100 like the patrol size gates, and NOT
#                     against each other: Tier5 at or below Tier4 is a legal
#                     thing to ask for.
#        Default:     50 / 75
#

ProceduralDungeon.V2.Loot.Currency.Tier4.MinDiff = 50
ProceduralDungeon.V2.Loot.Currency.Tier5.MinDiff = 75

#
#    ProceduralDungeon.V2.Loot.Currency.RoomsBaseline
#    ProceduralDungeon.V2.Loot.Currency.RoomsBonusPctPerRoom
#        Description: Round E (2026-09-10): the room factor, which scales every
#                     currency chance by the LENGTH of the run. A dungeon of
#                     RoomsBaseline ordinary rooms pays full price; a shorter
#                     one pays its plain share (5 of 10 rooms = 50 %); every
#                     room past the baseline adds RoomsBonusPctPerRoom percent
#                     on top (15 rooms = 105 %).
#
#                     Without it the shortest dungeon would be the most
#                     profitable one per minute - one room, one boss, reset -
#                     and nobody would ever build a long one again. The bonus
#                     above the baseline is deliberately thin: length should be
#                     worth choosing, not the only thing worth choosing.
#
#                     Counted in ORDINARY rooms, the same number the gen panel
#                     shows, and frozen with the run at spawn. The baseline is
#                     a room count and 0 is refused - at 0 every run would
#                     count as full and length would stop paying anything.
#        Default:     10 / 1
#

ProceduralDungeon.V2.Loot.Currency.RoomsBaseline = 10
ProceduralDungeon.V2.Loot.Currency.RoomsBonusPctPerRoom = 1

#
#    ProceduralDungeon.V2.Loot.Currency.ExtraMobsDropCurrency
#        Description: Round E (2026-09-10): whether the mobs that were never in
#                     the layout - event-room waves and the respawn copies -
#                     pay currency as well.
#
#                     Off, because those two are spawned in place and on demand:
#                     with currency on them the dungeon stops being a run and
#                     becomes a spot to stand in. Materials they DO always drop
#                     whatever this key says - mats are a crafting input and are
#                     supposed to be farmable, currency is progression.
#        Default:     0 - layout mobs only
#                     1 - event and respawn mobs pay too
#

ProceduralDungeon.V2.Loot.Currency.ExtraMobsDropCurrency = 0

#
#    ProceduralDungeon.V2.Loot.NativeItems
#        Description: Round E / WP8 (2026-09-10): whether a dungeon mob keeps
#                     the ITEM half of its own creature_template loot table.
#
#                     Off, and what the packs are made of is the reason: PDv2
#                     fills its rooms with STOCK creature entries - Shadowfang
#                     Keep, Scholomance, Ahn'kahet, Twilight - so every corpse
#                     hands out those dungeons' loot, from their greens to
#                     their quest-chain drops. None of that is FL content and
#                     none of it is what a kill in here is meant to be worth:
#                     the currency and the materials go straight into the bags
#                     of everybody on the map, and a room boss carries the gear
#                     this module injects (V2.Loot.Boss.Items). Turn this on to
#                     get the stock tables back on top of all of that.
#
#                     The GOLD is kept whatever this key says. It is not
#                     content - it is what any level-80 mob is worth - and
#                     dropping it as well would make every pull in the dungeon
#                     a net repair-bill loss. A corpse left with neither gold
#                     nor items stops shimmering instead of opening an empty
#                     loot window.
#
#                     Read live like every other V2 key, so `.reload config`
#                     decides what the NEXT corpse carries.
#        Default:     0 - this module's own funnel only
#                     1 - the creature's stock item table on top of it
#

ProceduralDungeon.V2.Loot.NativeItems = 0

#
#    ProceduralDungeon.V2.Loot.Mats.ChancePct
#    ProceduralDungeon.V2.Loot.Mats.MaxPerMobAtCap
#        Description: Round E (2026-09-10): crafting materials from every
#                     dungeon mob, drawn from the weighted FL mat pool across
#                     all three expansions - the same funnel and the same
#                     per-player recipients as the currencies.
#
#                     ChancePct is the whole gate: 0 stops materials entirely.
#                     MaxPerMobAtCap is the TOP of the band, not the count -
#                     the drop is a roll of 1 to that maximum, and the maximum
#                     itself grows with the ACCOUNT's dungeon level, from 1 at
#                     dlvl 0 to this value at V2.DlvlCap (so at the shipped 5
#                     and a cap of 30: dlvl 0 -> 1, 8 -> 2, 15 -> 3, 23 -> 4,
#                     30 -> 5). That is what puts account progression in the
#                     bag and not only on the character sheet.
#
#                     0 and 1 both mean one material per mob - the band floors
#                     at 1 - so turn materials off with ChancePct, not here.
#        Default:     100 / 5
#

ProceduralDungeon.V2.Loot.Mats.ChancePct = 100
ProceduralDungeon.V2.Loot.Mats.MaxPerMobAtCap = 5

#
#    ProceduralDungeon.V2.Loot.MatsToStorage
#        Description: Round E / WP10 (2026-09-11): put the materials a kill
#                     pays straight into the Endless Storage instead of the
#                     player's bags.
#
#                     The operator's ask, and the reason is arithmetic: a run
#                     pays materials on every tagged kill, to every player on
#                     the map, in stacks of up to Mats.MaxPerMobAtCap - the
#                     bags are full by the third room, and the Endless Storage
#                     is where those materials were always going to end up
#                     anyway. The bonus rare from Loot.BonusRollPct takes the
#                     same route.
#
#                     Only what the storage would actually SHOW is deposited -
#                     recipes, food and drink that stacks, trade goods and gems
#                     that stack, which is the storage's own rule read off its
#                     Lua. Anything else still goes to the bags, and to the
#                     mailbox from Chromie when those are full.
#
#                     The five Remnant currencies are NEVER deposited, whatever
#                     this says: they are trade goods and would qualify, but
#                     the Forgotten Talents tree counts them in the bags, so a
#                     deposited Remnant is one the player cannot spend.
#
#                     Needs mod-endless-storage: the deposit is one INSERT into
#                     its characters table `custom_endless_storage`. PDv2 does
#                     not require that module, so the worldserver checks for
#                     the table when it reads this config and turns the feature
#                     off for the session with one WARN when it is not there -
#                     `.reload config` probes again after an install.
#        Default:     1
#

ProceduralDungeon.V2.Loot.MatsToStorage = 1

#
#    ProceduralDungeon.V2.Loot.Chest.Items
#    ProceduralDungeon.V2.Loot.Boss.Items
#    ProceduralDungeon.V2.Loot.Final.Items
#        Description: Round E (2026-09-10): how many pieces of GEAR each of the
#                     three sources pays - a Shifting Cache in a dead end or a
#                     loop room, the run boss, and Chromie's Cache at the end.
#
#                     Each count is multiplied by the run's lootMult (x1.00 at
#                     difficulty 1 up to x3.00 at 100, times the caster factor)
#                     and the fraction left over is rolled: one item at x2.50
#                     is two items plus a coin flip, and pays 2.50 on average.
#                     Without that the difficulty dial would do nothing at all
#                     for gear.
#
#                     Three keys rather than one because the three sources are
#                     three different promises - a chest is a find, a boss is a
#                     fight, the final cache is the run's payout - and an
#                     operator who wants only one of them to be worth chasing
#                     must be able to say so. 0 silences that one source; the
#                     ceiling of 10 is already three times what difficulty 100
#                     multiplies it to.
#        Default:     1 / 1 / 1
#

ProceduralDungeon.V2.Loot.Chest.Items = 1
ProceduralDungeon.V2.Loot.Boss.Items = 1
ProceduralDungeon.V2.Loot.Final.Items = 1

#
#    ProceduralDungeon.V2.Loot.IccDlvl
#        Description: Round E (2026-09-10): the account dungeon level from which
#                     chests and the final cache stop drawing from the heroic-5
#                     and normal-raid pools and start drawing from the ICC ones
#                     - so the reward tier follows how far the account has come.
#
#                     The run's DIFFICULTY dial deliberately does not move this.
#                     Difficulty already pays in quantity (see the three .Items
#                     keys above); letting it also buy item level would let a
#                     brand-new account set the dial to 100 once and skip the
#                     progression the dungeon is built around. The run boss is
#                     not affected either way - it draws from the heroic raid
#                     pool at every dlvl.
#
#                     Clamped into 0..V2.DlvlCap: a value above the cap is a
#                     level no account can reach, which would be a switch that
#                     never happens. 0 puts every account on the ICC pools.
#        Default:     10
#

ProceduralDungeon.V2.Loot.IccDlvl = 10

#
#    ProceduralDungeon.V2.Loot.ClassFilter
#        Description: Round E (2026-09-10): roll gear the LOOTER can actually
#                     wear - armour type (the class's highest), weapon
#                     subclass, shields for warrior/paladin/shaman, relics, and
#                     the item's own AllowableClass/AllowableRace. The looter
#                     is whoever opened the chest, or the killer at a boss.
#
#                     On, because an unfiltered draw from a pool of a thousand
#                     items is mostly disenchant fodder and the reward at the
#                     end of a run should feel like a reward.
#
#                     Round E / WP9 added the STAT line on top of that, and it
#                     is the PLAYER's choice rather than a second server
#                     switch: a character who owns the Forgotten Talents node
#                     "Discerning Eye" gets a stat-profile row in the /pd panel
#                     (Off / Strength / Agility / Caster), the choice is stored
#                     per account, and every gear roll of the run then also
#                     asks whether the item's stats suit it - so a spell-power
#                     ring stops dropping for a rogue who asked it to. Off for
#                     everybody else, so a realm that never grants the node
#                     behaves exactly as it did. There is deliberately no key
#                     for it here: a talent an account bought is not something
#                     a .conf should be able to overrule.
#
#                     Whenever the filter would leave nothing to roll, it is
#                     given up in the order the player himself would give it up
#                     - the stat profile first, the class only if that still
#                     leaves nothing, the raw pool last. So a class the pool
#                     has no gear for gets something rather than nothing. 0 is
#                     for an operator who wants the raw pool; it turns the stat
#                     profile off with it, because the same roll applies both.
#        Default:     1 - filtered to the looter
#                     0 - raw pool
#

ProceduralDungeon.V2.Loot.ClassFilter = 1

#
#    ProceduralDungeon.V2.Cap.DeathUnlock
#    ProceduralDungeon.V2.Cap.CleanUnlock
#        Description: Round E (2026-09-10): how far one finished run pushes the
#                     account's DIFFICULTY CAP - the ceiling the 1..100 dial may
#                     be set to, which since this round is earned instead of
#                     given. Every account starts capped at 1, the operator's
#                     own included, and a completed run raises the cap to
#                     the run's own difficulty plus one of these two steps:
#                     CleanUnlock when nobody died during the run, DeathUnlock
#                     when somebody did.
#
#                     At the defaults a first clear at difficulty 1 unlocks 6, a
#                     clear of that at 6 unlocks 11, and a run that cost a death
#                     still moves the ceiling - just by less. That gap is the
#                     whole reason there are two keys and not one: dying has to
#                     cost something without ever becoming a dead end.
#
#                     Measured against the run's difficulty and NEVER against
#                     the cap, so grinding easy runs at a high ceiling cannot
#                     inch it upwards - the only way to unlock 50 is to clear
#                     something near 50. The cap only ever rises; the run's own
#                     frozen difficulty is untouched by it, and lowering these
#                     keys later takes nothing away from an account that has
#                     already earned its ceiling.
#
#                     Read live, at the moment a run is finished, so
#                     `.reload config` retunes the next completion. 0 means that
#                     outcome unlocks nothing at all; the GM test path is
#                     `.pdungeon v2 cap <n>`, which is the only thing in the
#                     module that may also lower a cap.
#        Default:     3 / 5
#

ProceduralDungeon.V2.Cap.DeathUnlock = 3
ProceduralDungeon.V2.Cap.CleanUnlock = 5

#
#    ProceduralDungeon.V2.CastRangeYd
#        Description: How far a range-role creature will hold and cast from.
#                     A range mob is only given a filler whose spell actually
#                     reaches this far; raising it past a spell's own range
#                     turns that mob into one that silently never casts, so
#                     re-check mod_pdungeon_member_spells.sql if you change it.
#
#                     There is deliberately no companion key for HOW OFTEN a
#                     mob casts. Every cooldown, the filler's included, is a
#                     column in pdungeon_member_spells - one server-wide number
#                     could never say "spam the Frostbolt but not the
#                     knockback".
#        Default:     25.0
#

ProceduralDungeon.V2.CastRangeYd = 25.0

#
#    ProceduralDungeon.V2.AggroRangeYd
#        Description: How close a player has to get before an idle dungeon
#                     creature attacks. The module supplies its own aggro
#                     because it spawns SHARED creature_template rows and must
#                     not edit them: six of v1's imported templates have
#                     detection_range 1 or 2 (measured 2026-08-07), which is
#                     deliberate for the map-741 dungeon they also belong to
#                     and would make them near-blind here. A mob still only
#                     aggroes a player it can actually walk to.
#        Default:     20.0
#

ProceduralDungeon.V2.AggroRangeYd = 20.0

#
#    ProceduralDungeon.V2.Decor.Enable
#        Description: Place the server-side props (torches, braziers) a layout
#                     calls for. The kit's terrain carries no light sources at
#                     all, so 0 leaves the dungeon lit by nothing - it is meant
#                     for chasing a GameObject budget or a display problem, not
#                     for play. The rules themselves live in
#                     pdungeon_decor_rules; this key only decides whether they
#                     are applied.
#
#                     Nothing reads the props: they are decoration, no mechanic
#                     keys on them, and turning them off changes no other
#                     number in the run.
#        Default:     1 - on
#                     0 - off
#

ProceduralDungeon.V2.Decor.Enable = 1

#
#    ProceduralDungeon.V2.Barrier.Pct
#        Description: Round B (2026-09-03): how much of a boss segment must be
#                     cleared before the portcullis in front of that segment's
#                     boss room opens, in percent of the trash the layout
#                     PLANNED for that segment's rooms.
#
#                     The boss room's own pack is deliberately not counted -
#                     it stands behind the barrier, and a segment whose only
#                     room is its boss (dlvl 30 with a low room count) would
#                     otherwise seal itself for ever. A segment with nothing
#                     planned in front of its boss opens immediately.
#
#                     Patrol and ambush mobs never count towards it either:
#                     they are risk on the road, not progress.
#        Default:     50 (0 = never sealed - the barrier opens the moment it is
#                     placed, since no kill is required; 100 = clear it all)
#

ProceduralDungeon.V2.Barrier.Pct = 50

#
#    ProceduralDungeon.V2.Barrier.OrientNS
#    ProceduralDungeon.V2.Barrier.OrientEW
#        Description: Round B (2026-09-03): the portcullis' facing in RADIANS,
#                     one value per lane orientation - NS for a doorway on a
#                     block's north or south edge, EW for its west or east one.
#
#                     Two conf keys rather than two constants because the right
#                     number depends on how the model is authored, and finding
#                     it means standing in front of one in game. Calibrate with
#                     `.reload config`; no rebuild and no re-roll is needed,
#                     the next barrier that is placed uses the new value.
#        Default:     0.0 / 1.5708 (that is pi/2, a quarter turn)
#

ProceduralDungeon.V2.Barrier.OrientNS = 0.0
ProceduralDungeon.V2.Barrier.OrientEW = 1.5708

#
#    ProceduralDungeon.V2.Patrol.HealthMult
#        Description: Round B (2026-09-03): the health of a patrolling creature,
#                     in percent of the trash mob it is drawn from - applied
#                     like every other health lever in this module, on top of
#                     the difficulty scale. EVERY member of a patrol gets it,
#                     the followers included.
#
#                     Since Round D (2026-09-08) there is one patrol per
#                     CORRIDOR - every corridor run between two rooms of the
#                     chain, not one per boss segment - and it walks that
#                     corridor doorway to doorway, never into a room. It is
#                     meant to be a real fight in a narrow place, so values
#                     below 100 are refused: a patrol softer than the pack it
#                     came from is loot walking towards the player, not a
#                     threat.
#
#                     Killing it moves no counter and opens no barrier.
#        Default:     300
#

ProceduralDungeon.V2.Patrol.HealthMult = 300

#
#    ProceduralDungeon.V2.Patrol.Size2Diff
#    ProceduralDungeon.V2.Patrol.Size3Diff
#        Description: Round D (2026-09-08): where a patrol grows from one
#                     creature to two and from two to three, on the run's own
#                     1..100 difficulty dial (the same dial `.pdungeon v2 set
#                     difficulty` moves). A run at difficulty 49 gets files of
#                     one, at 50 files of two, at 75 files of three.
#
#                     The members walk in SINGLE FILE: pick 0 of the corridor's
#                     draw leads and walks the planned beat, the others follow
#                     it at V2.Patrol.FollowDistYd times their rank. That is
#                     what keeps a bigger patrol from costing more paths - one
#                     patrol is one route however many creatures it has.
#
#                     Read live, but read at SPAWN time: changing either key
#                     retunes the next dungeon, not the corridor a player is
#                     standing in. Both are clamped into 1..100 and NOT against
#                     each other - Size3Diff at or below Size2Diff simply makes
#                     the two-mob band empty, which is a legitimate thing to
#                     ask for.
#        Default:     50 / 75
#

ProceduralDungeon.V2.Patrol.Size2Diff = 50
ProceduralDungeon.V2.Patrol.Size3Diff = 75

#
#    ProceduralDungeon.V2.Patrol.FollowDistYd
#        Description: Round D (2026-09-08): how far behind the leader the first
#                     follower of a patrol walks, in yards. Follower k keeps k
#                     times this distance, so a file of three is 3.0 and 6.0 yd
#                     long at the default.
#
#                     Read live and used on every follow decision, so
#                     `.reload config` re-spaces the files of a dungeon that is
#                     already being walked. The corridor lane is 16.67 yd wide,
#                     so anything up to about 8 yd keeps the whole file inside
#                     it however the corridor turns. Negative values are
#                     refused (that would put the follower in front).
#        Default:     3.0
#

ProceduralDungeon.V2.Patrol.FollowDistYd = 3.0

#
#    ProceduralDungeon.V2.Patrol.Debug
#        Description: Round C (2026-09-08): per-leg diagnostics for the
#                     patrolling creatures, in the worldserver log under
#                     `module.pdungeon`. 0 = silent, 1 = talkative. OFF
#                     everywhere but a run somebody is actively watching -
#                     these lines are per waypoint, per movement inform and per
#                     evade, which is a lot of log for a dungeon full of mobs
#                     and no use at all to anyone not hunting a patroller.
#
#                     Read LIVE on the tick that would log, so `.reload config`
#                     both arms and disarms it without a restart and without
#                     re-rolling anything - turn it on, pull the patroller,
#                     turn it back off.
#
#                     What it prints, all prefixed `PDv2 patrol:` except the
#                     chase verdict, which is `PDv2 chase:`
#
#                       * one line per LEG - the waypoint, its cell, the world
#                         point, where the creature stands, the top movement
#                         generator and the distance. A leg is a few cells, and
#                         a cell is 8.33 yd, so a distance in the hundreds is
#                         not a leg.
#                       * one line per movement inform, INCLUDING the ones the
#                         module drops - that is the only way to see a leg that
#                         ended without anyone noticing.
#                       * three lines per EVADE plus one when the creature
#                         reaches home: position, home, the motion stack, and
#                         whether the movement spline is finalized. The last of
#                         the three is the decisive one - `splineFinalized 1`
#                         is a creature that has actually stopped.
#                       * one line per patroller on its first tick, naming its
#                         idle movement slot, its wander distance and whether
#                         it is levitating.
#                       * one line per CHASE decision, but only when the
#                         verdict or the motion stack changed - so a fight in
#                         which nothing moves costs one line.
#
#                     `.pdungeon v2 patrol` (GM) answers the same question for
#                     RIGHT NOW, one line per patroller, without the log and
#                     without this key.
#        Default:     0
#

ProceduralDungeon.V2.Patrol.Debug = 0

#
#    ProceduralDungeon.V2.Debug
#        Description: Round E (2026-09-10): the module's per-creature,
#                     per-tick and per-client-verb diagnostics, in the
#                     worldserver log under `module.pdungeon`. 0 = silent,
#                     1 = talkative. OFF everywhere but a run somebody is
#                     actively watching - every line behind this key is one a
#                     single five-room dungeon prints dozens of times.
#
#                     The lines print at INFO once the key is on, so turning
#                     it on is the WHOLE operation: no Logger.module level to
#                     find, nothing to put back afterwards. Read LIVE on the
#                     line that would log, so `.reload config` both arms and
#                     disarms it without a restart and without re-rolling
#                     anybody's dungeon.
#
#                     What it prints, all prefixed `PDv2`:
#
#                       * one line per CREATURE the instance spawns, naming
#                         its entry, name, faction, whether it is selectable
#                         and its display id. That is the line that settled
#                         the 2026-08-10 invisible-attacker hunt, and there
#                         are a hundred-odd of them per run.
#                       * one line per Lil' Bro SPLIT - so one per kill of a
#                         splitting mob, and one more per kill of every child.
#                       * one line per player DEATH, with the run's tally.
#                       * one line per player caught FALLING off the dungeon,
#                         which is per tick for a player who keeps sliding off
#                         the same ledge (the player's own chat line is not
#                         gated).
#                       * one line per PULL in which a mob called reachable
#                         allies into the fight - so one per fight.
#                       * one line per patrol re-plan that had to fall back to
#                         the walk grid, planning a beat or rejoining one.
#                         These two were WARNs until Round E: the squeeze past
#                         a pinched lane row is a designed fallback and a
#                         property of the kit, not a fault of the run.
#                       * one line per client ACK relayed up, and one per
#                         malformed or unknown verb from the panel (a bad SET,
#                         an unknown SET key, a locked-band SET, a bad HUD
#                         toggle, an unknown verb). What the panel sends is
#                         client traffic, so its volume is not the server's to
#                         bound.
#                       * one line per GEAR ROLL while V2.Loot.ClassFilter is
#                         on, naming the pool, how much of it the looter's
#                         class can wear and what the filter cost in ms.
#
#                     What it does NOT gate, and what therefore still prints
#                     on a silent host: the startup and load summaries, the
#                     per-run build summaries (spawns, props, barriers,
#                     patrols, ambushes), the finale and FinishRun lines, the
#                     per-cache loot payout, and every WARN or ERROR that
#                     names a data fault - a missing chest anchor, an unknown
#                     pack member, an unknown loot item, a dropped loot row.
#                     A fault is never diagnostics.
#
#                     Independent of V2.Patrol.Debug above, which arms the
#                     patrol AI's own per-leg trace. That is a different hunt
#                     at a different volume: neither key implies the other.
#        Default:     0
#

ProceduralDungeon.V2.Debug = 0

#
#    ProceduralDungeon.V2.Ambush.Chance
#        Description: Round B (2026-09-03): percent chance, per boss segment,
#                     that one of the corridors on the way to its boss room is
#                     armed with an ambush. At most one per segment, and a
#                     segment whose runs hold no usable corridor gets none.
#
#                     Read live like the decor rules: it is not part of what a
#                     layout IS, so changing it re-arms the next run rather
#                     than re-rolling anybody's dungeon.
#
#                     WHAT FIRES an armed corridor, since Round C (2026-09-08):
#                     standing in it. The whole 66.67 yd block is the trigger -
#                     the player's walk-grid cell is compared against the
#                     spot's block, and that cell has to be floor - so every
#                     corridor kind behaves the same and there is no distance
#                     to tune. Each armed corridor is named in the worldserver
#                     log at build time with its segment, block, chunk and
#                     centre, which is how an "it never fired" is checked
#                     against the layout that was actually walked.
#        Default:     50
#

ProceduralDungeon.V2.Ambush.Chance = 50

#
#    ProceduralDungeon.V2.Ambush.Mobs
#        Description: Round B (2026-09-03): how many creatures an ambush spawns
#                     around the player it fires on. They fight, scale and drop
#                     loot like any dungeon mob but count towards nothing - not
#                     the run total, not a room, not a barrier.
#
#                     Clamped to 0..8: the spawn pattern beside the player is
#                     a fixed table of eight distinct places (two ranks of
#                     four, at 6 yd and 2 yd along the corridor, 4 yd either
#                     side of it), and past the eighth the table repeats and
#                     would stack mobs inside each other. 0 leaves the trigger
#                     and the stun in place with nothing to fight.
#
#                     Read when an instance BUILDS its dungeon, not when the
#                     ambush fires: the creatures are drawn once and stored
#                     with the spot, so a .reload config takes effect for the
#                     next dungeon that is built and leaves a standing run
#                     alone. Chance is read per build the same way; StunSpell
#                     is the only one of the three read at fire time, and
#                     therefore the only one that changes a standing run.
#        Default:     4
#

ProceduralDungeon.V2.Ambush.Mobs = 4

#
#    ProceduralDungeon.V2.Ambush.RadiusYd
#        REMOVED in Round C (2026-09-08). The setting no longer exists; a line
#        left over in a deployed .conf is ignored and can be deleted.
#
#        It used to say how close a player had to come to an armed corridor's
#        centre, flat, before the trap fired - default 9.0 yd. That worked on a
#        straight corridor and nowhere else: the four centre cells of a block
#        form a junction square of half-width 8.33 yd, so a straight transit
#        passes its inscribed disc at 8.08 yd, while the shortest walking line
#        through a corner, a T or a cross hugs the square's corner at
#        8.33 * sqrt(2) = 11.79 yd and missed the disc entirely - as did the
#        dogleg around the centre pillar of the alt-1 straight, at 11.43 yd.
#        Four of the kit's five corridor kinds - corner, T, cross and the
#        alt-1 straight with its centre pillar - could be walked past; only
#        the plain straight ever passed close enough to fire.
#
#        Widening the radius would have closed the hole with a number that
#        silently breaks the day the kit's corridor width changes. The trigger
#        is the corridor BLOCK instead - see V2.Ambush.Chance above.
#

#
#    ProceduralDungeon.V2.Ambush.StunSpell
#        Description: Round B (2026-09-03): the aura an ambush applies to the
#                     player it fires on, with the player as the caster. The
#                     default is the generic 2-second "Stun" (20170): aura-only,
#                     flat duration, mechanic 12, and it releases itself - so
#                     the client shows a real stun with a debuff icon and no
#                     code has to remember to take it off.
#
#                     0 means the ambush spawns its mobs without a stun. Any
#                     other id is used as given; a spell that does not stun
#                     simply makes the ambush a plain spawn.
#        Default:     20170
#

ProceduralDungeon.V2.Ambush.StunSpell = 20170

#
#    ProceduralDungeon.V2.Event.ChancePct
#        Description: Round E / WP5 (2026-09-10): percent chance, per boss
#                     segment, that the segment gets an EVENT ROOM - a
#                     dead-end pocket off the main path with a lost pilgrim
#                     in it who asks to be defended. A gossip click starts
#                     the defence: attackers spawn at the room's rim and go
#                     for him, and if he is still standing when the timer
#                     runs out a cache appears and everyone on the map is
#                     paid Paragon XP. At most one per segment, and a
#                     segment with no free spine room to hang the pocket
#                     off gets none.
#
#                     A LAYOUT input, and the only one of the five V2.Event
#                     keys that is: the room is drawn by the GENERATOR, so
#                     this value is read when a dungeon is generated and
#                     stored with it (pdungeon_account.gen_event_pct) for
#                     login to rebuild the same dungeon from. A .reload
#                     config therefore reaches the NEXT dungeon somebody
#                     generates and leaves every stored one exactly as it
#                     is - `.pdungeon v2 gen` is what applies a new value
#                     to an account.
#
#                     0 switches event rooms off and costs no draw at all,
#                     so a layout generated at 0 is identical to one from
#                     before the feature existed.
#        Default:     25
#

ProceduralDungeon.V2.Event.ChancePct = 25

#
#    ProceduralDungeon.V2.Event.DurationSec
#        Description: Round E / WP5: how long one defence runs, in seconds.
#                     The event IS this countdown - the pilgrim only has to
#                     be alive when it reaches zero - so a longer timer
#                     makes the event harder, not slower.
#
#                     Clamped to 10..600. Under ten seconds the wave timer
#                     barely gets its first attacker out and the reward
#                     would be free; over ten minutes one event outlasts
#                     the run it sits in. Read LIVE, so a .reload config
#                     retunes the next defence that is STARTED and leaves
#                     one that is already being fought alone.
#        Default:     60
#

ProceduralDungeon.V2.Event.DurationSec = 60

#
#    ProceduralDungeon.V2.Event.SpawnEverySec
#        Description: Round E / WP5: how often a running defence sends the
#                     next attacker, in seconds. With the two defaults that
#                     is roughly a dozen creatures over a 60 s fight,
#                     arriving one at a time - the pressure comes from the
#                     stream, not from the size of any one wave.
#
#                     Clamped to 1..60: one per second is as fast as the
#                     1 Hz tick can spawn anything, and a gap longer than a
#                     minute outlives the longest defence the key above
#                     allows. Read LIVE.
#        Default:     5
#

ProceduralDungeon.V2.Event.SpawnEverySec = 5

#
#    ProceduralDungeon.V2.Event.CasterPct
#        Description: Round E / WP5: percent of an event wave drawn as
#                     casters, the rest melee. Deliberately far below the
#                     account's own caster ratio: the attackers have to
#                     CLOSE on the pilgrim for the defence to be a fight
#                     worth standing in, and a caster-heavy wave would
#                     simply shoot him from the rim while the players give
#                     chase.
#
#                     Clamped to 0..100. Read LIVE, when a defence draws
#                     its wave.
#        Default:     10
#

ProceduralDungeon.V2.Event.CasterPct = 10

#
#    ProceduralDungeon.V2.Event.ParagonXp
#        Description: Round E / WP5: the Paragon XP every player on the map
#                     is paid when a defence is WON, before the run's loot
#                     multiplier scales it. Nothing is paid for a defence
#                     that fails; 0 pays nothing at all and leaves the
#                     cache as the whole reward.
#
#                     Unclamped on purpose, like V2.Ambush.StunSpell above:
#                     the type (unsigned) is already the only bound that
#                     matters, and what one module pays into another's
#                     progression is the operator's call and not this
#                     module's. Read LIVE, at the moment the event is won.
#        Default:     1000
#

ProceduralDungeon.V2.Event.ParagonXp = 1000

#
#    ProceduralDungeon.V2.Respawn.Enable
#        Description: Round E / WP6 (2026-09-10): whether the Forgotten
#                     Talents node "Restless Echoes" does anything in this
#                     dungeon. With it on, an ordinary monster killed by a
#                     player who owns that node rises again on the spot as
#                     one echo per rank - the same creature, freshly hostile
#                     and already coming for the killer.
#
#                     The TALENT is the entitlement: nobody who has not
#                     bought the node gets an echo whatever this key says.
#                     What the module reads is not a spell id but the
#                     node's tag - EffectMiscValue 76001 on its passive
#                     dummy aura - so mod-forgotten-talents can regenerate
#                     its spells without this ever noticing.
#
#                     An echo is never part of the run: it moves no kill
#                     counter, clears no room, opens no barrier and cannot
#                     be the boss of one. What it does pay is materials,
#                     always, and Paragon XP - currency only when
#                     V2.Loot.Currency.ExtraMobsDropCurrency is on, because
#                     a monster that comes back for ever would otherwise be
#                     a currency faucet. An echo never echoes again, and a
#                     boss never echoes at all.
#
#                     0 makes the node inert without touching anybody's
#                     talent tree - the switch to reach for when a farm
#                     turns out to be one. Read LIVE, so a .reload config
#                     arms and disarms it on a run already being walked.
#        Default:     1
#

ProceduralDungeon.V2.Respawn.Enable = 1

#
#    ProceduralDungeon.V2.Respawn.MaxCopies
#        Description: Round E / WP6: the most echoes ONE kill may raise,
#                     whatever the talent's rank says. The node's own
#                     maximum is 2 today, so this default costs nothing;
#                     it is the operator's ceiling for the day a later rank
#                     - or a typo in the talent extension contract - asks
#                     for more than the loot funnel was tuned for.
#
#                     Clamped to 0..5. 0 is the softer of the two switches
#                     above: the mechanic still runs and simply raises
#                     nothing. Read LIVE.
#        Default:     2
#

ProceduralDungeon.V2.Respawn.MaxCopies = 2

#
#    ProceduralDungeon.V2.Finale.TeleName
#        Description: Round E / WP10: where the finale portal puts the player,
#                     as the NAME of a row in acore_world.game_tele - the same
#                     names a GM types after `.tele`.
#
#                     The portal used to carry its destination as four
#                     literals in C++, which meant that moving the arrival
#                     spot meant a rebuild. It now looks the row up on every
#                     click, so the portal follows the world data: move
#                     `flcapital` in game_tele and the next run's portal lands
#                     where you moved it.
#
#                     The shipped default is the capital (operator, 2026-09-11
#                     - a finished run belongs back in town, not at the raid
#                     door): row 20042 `flcapital`, map 727, 13356.2 /
#                     12009.1 / -23.39, facing 4.50. C8's original
#                     `flraidazealia` is row 20040 on the same map.
#
#                     The match is EXACT and case-insensitive, so a name that
#                     is not a row - a typo, a blank value, a row somebody
#                     deleted - resolves to nothing rather than to whichever
#                     row happens to contain the text. That case is not
#                     silent: the player is sent to `flraidazealia`, the C8
#                     destination compiled in as the fallback, and the
#                     worldserver logs a WARN naming the key on every click.
#
#                     Read LIVE like every other V2 key: `.reload config`
#                     retargets the next click, including one in a run that is
#                     already being walked.
#        Default:     "flcapital"
#

ProceduralDungeon.V2.Finale.TeleName = "flcapital"

