+def pad_span_yd(fp):
+    """The pad's edge-to-edge span in yards, or 0.0 when there is no pad.
+
+    THE expression add_pad_facades() measures its own span with (v1 - v0 over
+    the pad's columns) - one function so the reserve decided at the call site
+    and the branch actually taken inside can never drift apart. Written in the
+    two-step v0/v1 form on purpose: (cs[-1] + 1 - cs[0]) * CELL_SIDE_YD is the
+    same value in algebra and a different float on the real 2x2 pad
+    (16.6666665625 against 16.666666562499998), and span feeds an inequality
+    and the offsets of the ring branch.
+    """
+    if not fp:
+        return 0.0
+    cs = sorted({c for _, c in fp})
+    v0, v1 = cs[0] * CELL_SIDE_YD, (cs[-1] + 1) * CELL_SIDE_YD
+    return v1 - v0
+
+
+def pad_facade_reserve(fp):
+    """WMO slots add_facades() must leave for the pad, by the pad's own size.
+
+    A ring pad (>= PAD_MIN_SPAN_YD) seats up to PAD_FACADE_SLOTS houses; the
+    small pad below that threshold gets exactly one centred building out of
+    add_pad_facades()'s small-pad branch, so it costs one slot, not eight. No
+    pad at all costs nothing.
+    """
+    if not fp:
+        return 0
+    return PAD_FACADE_SLOTS if pad_span_yd(fp) >= PAD_MIN_SPAN_YD else 1
+
