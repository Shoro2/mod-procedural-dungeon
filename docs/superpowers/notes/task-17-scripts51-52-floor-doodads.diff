+# --------------------------------------------------------------------------- #
+# Low-quality texture map (Task 17)
+#
+# WHY THIS SCRIPT, NOT 51
+#   51_texture_blockkit.py points layer 1 - the floor, in this kit's inverted
+#   layer order - at a stock GroundEffectTexture.dbc row (its own Step 1),
+#   but that alone renders nothing. The client decides which of a MCNK's up
+#   to 4 MCLY layers gets to scatter ground-effect doodads over a given
+#   sub-cell from THIS field: the MCNK header's low-quality texture map at
+#   payload offset 0x40, 16 bytes, 2 bits per 8x8 sub-cell (the SAME 4.1667 yd
+#   quad grid the final-surface normals above already walk - QUADS_PER_
+#   HOLE_CELL=2 sub-quads per 8.33 yd hole cell, both axes). Every kit MCNK
+#   inherits this field all-zero from the donor tile, and 0 names layer 0 -
+#   the WALL texture now - so leaving it alone would scatter 51's doodads
+#   across the wall band instead of the floor, and writing it wrong (layer 1
+#   named where the wall is) would scatter them over floor AND wall alike.
+#   This belongs here rather than in 51 because writing 0x40 needs exactly
+#   the `classes` grid and the `transposed` axis convention 52 already
+#   measured for holes - one surface, one consumer, no second derivation of
+#   either to drift out of step with the first.
+#
+# THE BIT ORDER IS MEASURED, NOT ASSUMED
+#   Same discipline the hole bit order above already follows, for the same
+#   reason: this project has already paid for guessing an axis convention
+#   once. measure_low_qual_bit_order() decodes the 16 raw 0x40 bytes of a
+#   real, client-rendered Blizzard MCNK (PVPZone02_30_32.adt MCNK[0] - the
+#   same reference tile 51's docstring and this script's normal validation
+#   already lean on) under BOTH candidate sub-cell orders, the same
+#   row-major/transposed ambiguity `transposed` resolves for holes (both
+#   fields pack a small 2D grid into a fixed-width run, low bits first), and
+#   checks each against that MCNK's own MCAL: a sub-cell the field names as
+#   layer 1 must sit over HIGH layer-1 alpha, one naming layer 0 over LOW
+#   layer-1 alpha. Whichever order gives a clean, non-overlapping split is
+#   kept; if both or neither do, this refuses to write anything rather than
+#   guess.
+# --------------------------------------------------------------------------- #
+MCNK_OFS_LOW_QUAL = 0x40
+LOW_QUAL_SIDE = 8                # 8x8 sub-cells per MCNK, 2 bits each
+LOW_QUAL_BYTES = 16              # 8*8*2 bits / 8 = 16
+LOW_QUAL_LAYER_WALL = 0          # MCLY layer 0 - opaque wall/base (51's build_mcly)
+LOW_QUAL_LAYER_FLOOR = 1         # MCLY layer 1 - the floor blend, carries the effect id
+ALPHA_BYTES = 2048               # one 4-bit alpha map, measured in 51 and re-used as-is
+
+MCNK_OFS_MCLY = 0x1C
+MCNK_OFS_MCAL = 0x24
+
+
+def _resolve_sub_chunk(data, payload_ofs, field_ofs, expect_tag):
+    """Chunk-start-relative sub-chunk lookup (payload offset + 8), the same
+    convention 51 measures and asserts per MCNK. Used only to read the ONE
+    reference MCNK the bit-order measurement below needs - the kit's own
+    MCLY/MCAL stay 51's to rebuild, never parsed here."""
+    ofs = struct.unpack_from("<I", data, payload_ofs + field_ofs)[0]
+    at = payload_ofs - 8 + ofs
+    tag = data[at:at + 4][::-1].decode("ascii", "replace")
+    if tag != expect_tag:
+        raise SystemExit("%s not where the header says (found %r)" % (expect_tag, tag))
+    return at + 8
+
+
+def _mcly_layer_count(data, payload_ofs):
+    return struct.unpack_from("<I", data, payload_ofs + 0x0C)[0]
+
+
+def _mcal_layer1(data, payload_ofs):
+    """Reference MCNK's layer-1 alpha as 4096 nibble values (0..15), row-major
+    over the 64x64 map - low nibble is the even pixel, matching 51's
+    pack_alpha_values encoding, which this project already measured against
+    this very file."""
+    base = _resolve_sub_chunk(data, payload_ofs, MCNK_OFS_MCAL, "MCAL")
+    out = []
+    for i in range(ALPHA_BYTES):
+        byte = data[base + i]
+        out.append(byte & 0x0F)
+        out.append((byte >> 4) & 0x0F)
+    return out
+
+
+def _low_qual_decode(raw16, transposed):
+    """16 raw 0x40 bytes -> 8x8 grid of 2-bit values, one hypothesis."""
+    grid = [[0] * LOW_QUAL_SIDE for _ in range(LOW_QUAL_SIDE)]
+    for hr in range(LOW_QUAL_SIDE):
+        for hc in range(LOW_QUAL_SIDE):
+            idx = (hc * LOW_QUAL_SIDE + hr) if transposed else (hr * LOW_QUAL_SIDE + hc)
+            byte = raw16[idx // 4]
+            grid[hr][hc] = (byte >> ((idx % 4) * 2)) & 0x3
+    return grid
+
+
+def pack_low_qual(grid, transposed):
+    """8x8 grid of 2-bit layer indices -> the 16-byte 0x40 field, in whichever
+    order measure_low_qual_bit_order() found clean. Same LSB-first, one-
+    sub-cell-per-2-bits packing pack_holes already uses for the 4x4 hole
+    mask, just twice the side and half as many bits per cell."""
+    out = bytearray(LOW_QUAL_BYTES)
+    for hr in range(LOW_QUAL_SIDE):
+        for hc in range(LOW_QUAL_SIDE):
+            idx = (hc * LOW_QUAL_SIDE + hr) if transposed else (hr * LOW_QUAL_SIDE + hc)
+            out[idx // 4] |= (grid[hr][hc] & 0x3) << ((idx % 4) * 2)
+    return bytes(out)
+
+
+def measure_low_qual_bit_order():
+    """Decide row-major vs transposed for the 0x40 field by measurement
+    against PVPZone02_30_32.adt MCNK[0], exactly as described in the section
+    docstring above. Returns (transposed, stats) where stats holds the mean
+    alpha of each predicted population under each hypothesis, for the report.
+    """
+    arc = r"World\Maps\PVPZone02\PVPZone02_30_32.adt"
+    data, _archive = pdl.extract_adt(arc)
+    offsets = mcnk_offsets(data)
+    if not offsets:
+        raise SystemExit("0x40 bit-order measurement: reference tile has no MCNKs")
+    payload_ofs, _size = offsets[0]
+
+    if _mcly_layer_count(data, payload_ofs) < 2:
+        raise SystemExit("0x40 bit-order measurement: reference MCNK[0] has "
+                         "no layer 1 to measure alpha against")
+    alpha1 = _mcal_layer1(data, payload_ofs)
+    raw16 = bytes(data[payload_ofs + MCNK_OFS_LOW_QUAL:
+                       payload_ofs + MCNK_OFS_LOW_QUAL + LOW_QUAL_BYTES])
+    if len(raw16) != LOW_QUAL_BYTES:
+        raise SystemExit("0x40 bit-order measurement: short read on the reference tile")
+
+    stats = {}
+    for transposed in (False, True):
+        grid = _low_qual_decode(raw16, transposed)
+        layer1_means, layer0_means = [], []
+        for hr in range(LOW_QUAL_SIDE):
+            for hc in range(LOW_QUAL_SIDE):
+                pixels = [alpha1[pr * 64 + pc]
+                         for pr in range(hr * 8, hr * 8 + 8)
+                         for pc in range(hc * 8, hc * 8 + 8)]
+                mean = sum(pixels) / float(len(pixels))
+                target = grid[hr][hc]
+                if target == LOW_QUAL_LAYER_FLOOR:
+                    layer1_means.append(mean)
+                elif target == LOW_QUAL_LAYER_WALL:
+                    layer0_means.append(mean)
+        stats[transposed] = (layer1_means, layer0_means)
+        l1_avg = sum(layer1_means) / len(layer1_means) if layer1_means else float("nan")
+        l0_avg = sum(layer0_means) / len(layer0_means) if layer0_means else float("nan")
+        say("    %-12s %2d layer-1 sub-cell(s) mean %.2f/15, "
+            "%2d layer-0 sub-cell(s) mean %.2f/15",
+            "transposed" if transposed else "row-major",
+            len(layer1_means), l1_avg, len(layer0_means), l0_avg)
+
+    # Clean = the two predicted populations do not overlap at all - the same
+    # cleanliness bar the hole bit order applies ("no hole lands on a
+    # walkable cell"). A wrong axis mixes predicted-floor and predicted-wall
+    # sub-cells into overlapping alpha ranges; the real one does not.
+    clean = [t for t, (l1, l0) in stats.items() if l1 and l0 and min(l1) > max(l0)]
+    if len(clean) != 1:
+        raise SystemExit("cannot decide the 0x40 bit order from the reference "
+                         "tile (clean orders: %s) - refusing to guess" % clean)
+    return clean[0], stats
+
