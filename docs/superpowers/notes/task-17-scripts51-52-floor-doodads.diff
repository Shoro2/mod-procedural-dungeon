+def _gate_wall_distance(classes, gu, gv):
+    """Verify-gate-only re-derivation of paint_block_alpha's wall distance.
+
+    Deliberately NOT a call into _wall_distance (or the _class_at it reads
+    through). A gate that asks the code under test what it produced will
+    agree with any bug the two of them happen to share, and this project
+    has already paid for exactly that shape of mistake twice: this file's
+    own specular-texture check used to pass while shipping a solid-green
+    dungeon floor because it asked "does the path resolve" instead of
+    re-deriving "will the layer bind" (see the "[2] Textures" section
+    below), and 48_gen_t1_blockkit.py's anchor-only walkability check
+    passed while 8 of 15 masks still had a floor cell marked unwalkable,
+    because it trusted the same computation it was meant to be checking
+    (48:3045-3046). A verify gate only earns its keep if it is capable of
+    disagreeing with the thing it guards, which requires its own,
+    independently written implementation - not a shared helper the two
+    call into.
+
+    Same Chebyshev-ring definition as _wall_distance (nearest wall/void
+    pixel, capped at FEATHER_TEXELS), but built differently on purpose: the
+    ring at each radius is walked as four explicit edges (top row, bottom
+    row, then the left/right columns with the two corners already covered
+    by the rows left out) rather than filtering a full (2d+1)x(2d+1)
+    square, and the cell-class lookup is inlined here instead of shared -
+    matching how the invariant that calls this already inlines its own
+    cell_r/cell_c/cls rather than calling _class_at.
+    """
+    for d in range(1, FEATHER_TEXELS + 1):
+        edge = []
+        for dv in range(-d, d + 1):
+            edge.append((-d, dv))
+            edge.append((d, dv))
+        for du in range(-d + 1, d):
+            edge.append((du, -d))
+            edge.append((du, d))
+        for du, dv in edge:
+            pu, pv = gu + du, gv + dv
+            cell_r = min(max(pu // PIXELS_PER_CELL, 0), WALK_CELLS_PER_BLOCK - 1)
+            cell_c = min(max(pv // PIXELS_PER_CELL, 0), WALK_CELLS_PER_BLOCK - 1)
+            if classes[cell_r * WALK_CELLS_PER_BLOCK + cell_c] in (CLASS_WALL_L, CLASS_VOID_L):
+                return d
+    return FEATHER_TEXELS
+
+
